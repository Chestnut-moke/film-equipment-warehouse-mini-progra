.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.45);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal {
  width: 600rpx;
  max-height: 85vh;
  overflow-y: auto;
  padding: 36rpx;
  border-radius: 24rpx;
  background: #fff;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111;
  margin-bottom: 28rpx;
  text-align: center;
}

.field {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #F0F0F5;
}

.label {
  width: 140rpx;
  font-size: 28rpx;
  color: #666;
  flex-shrink: 0;
}

.field input {
  flex: 1;
  font-size: 28rpx;
}

.field-textarea {
  flex-direction: column;
  align-items: stretch;
}

.field-textarea .label {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.field-textarea textarea {
  width: 100%;
  height: 260rpx;
  font-size: 26rpx;
  padding: 14rpx;
  border-radius: 12rpx;
  background: #f5f5f7;
  box-sizing: border-box;
}

.terms-actions {
  display: flex;
  gap: 16rpx;
  margin-left: auto;
}

.terms-link {
  font-size: 22rpx;
  font-weight: 400;
  color: #007AFF;
  padding: 4rpx 0;
}

.terms-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #c7c7cc;
  margin-top: 6rpx;
}

.terms-edit-modal {
  max-height: 85vh;
  overflow-y: auto;
}

.terms-edit-modal .field-textarea textarea {
  height: 360rpx;
}

.picker-value {
  flex: 1;
  font-size: 28rpx;
  color: #111;
}

.checkbox-line {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid #F0F0F5;
}

.secondary-btn {
  display: block;
  text-align: center;
  padding: 18rpx 0;
  margin: 12rpx 0;
  font-size: 28rpx;
  color: #007AFF;
  border-radius: 12rpx;
  background: #F5F5F7;
}

.modal-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}

.modal-actions .secondary-btn,
.modal-actions .primary-btn {
  flex: 1;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
  border-radius: 16rpx;
  margin: 0;
}

.modal-actions .secondary-btn {
  background: #F5F5F7;
  color: #666;
}

.primary-btn {
  display: block;
  text-align: center;
  padding: 22rpx 0;
  font-size: 30rpx;
  color: #fff;
  border-radius: 16rpx;
  background: #007AFF;
}
