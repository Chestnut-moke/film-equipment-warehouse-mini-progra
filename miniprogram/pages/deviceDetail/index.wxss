.detail-card {
  padding: 30rpx;
}

.device-no {
  color: #6e6e73;
  font-size: 25rpx;
  font-weight: 800;
}

.device-name {
  margin-top: 18rpx;
  font-size: 46rpx;
  line-height: 56rpx;
  font-weight: 800;
}

.device-meta {
  margin-top: 10rpx;
  color: #86868b;
  font-size: 27rpx;
}

.qr-box {
  margin-top: 28rpx;
  padding: 24rpx;
  border-radius: 18rpx;
  background: #f5f5f7;
}

.barcode-canvas {
  max-width: 100%;
  height: 120rpx;
  margin: 0 auto 12rpx;
  display: block;
}

.qr-code {
  font-size: 34rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  text-align: center;
}

.qr-tip {
  margin-top: 8rpx;
  color: #86868b;
  font-size: 23rpx;
}

.info-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14rpx;
  margin-top: 18rpx;
}

.info {
  padding: 22rpx 12rpx;
  text-align: center;
}

.info-value {
  font-size: 32rpx;
  font-weight: 800;
}

.info-label {
  margin-top: 6rpx;
  color: #86868b;
  font-size: 22rpx;
}

.list {
  overflow: hidden;
}

.line {
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
  font-size: 28rpx;
}

.line:last-child {
  border-bottom: none;
}

.line text:last-child {
  color: #6e6e73;
}

.long {
  margin-top: 10rpx;
  line-height: 42rpx;
}

.button-grid {
  display: grid;
  gap: 16rpx;
  margin-top: 24rpx;
}

.danger-row {
  display: flex;
  gap: 16rpx;
}

.danger-row .danger-btn,
.danger-row .secondary-btn {
  flex: 1;
}

.mini-schedule {
  padding: 20rpx;
}

.mini-row {
  display: flex;
}

.mini-day,
.mini-cell {
  width: 96rpx;
  flex-shrink: 0;
  margin-right: 4rpx;
  text-align: center;
}

.mini-day {
  height: 74rpx;
  padding-top: 10rpx;
  color: #6e6e73;
  font-size: 22rpx;
  font-weight: 800;
}

.mini-week {
  margin-top: 4rpx;
  color: #a1a1a6;
  font-size: 19rpx;
}

.mini-cell {
  height: 72rpx;
  padding: 12rpx 6rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 20rpx;
  font-weight: 800;
  overflow: hidden;
}

.cell-free {
  background: #f5f5f7;
  color: #c7c7cc;
}

.cell-reserved {
  background: #fff4ce;
  color: #9a6700;
}

.cell-rented {
  background: #e8f2ff;
  color: #0066d6;
}

.cell-overdue {
  background: #ffe8e6;
  color: #c9342b;
}

.cell-partReturned {
  background: #fff0df;
  color: #b85d00;
}

.cell-repairing {
  background: #eeeeff;
  color: #5e5ce6;
}

.schedule-more {
  height: 72rpx;
  margin-top: 18rpx;
  color: #007aff;
  font-size: 27rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
}

.schedule-item {
  padding: 22rpx;
  margin-bottom: 14rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.schedule-title {
  font-size: 29rpx;
  font-weight: 800;
}

.schedule-sub {
  margin-top: 8rpx;
  color: #86868b;
  font-size: 24rpx;
}

.log {
  padding: 22rpx;
  margin-bottom: 14rpx;
}

.log-title {
  font-size: 29rpx;
  font-weight: 800;
}

.log-sub,
.log-time {
  margin-top: 8rpx;
  color: #86868b;
  font-size: 24rpx;
}

.empty {
  padding: 36rpx;
  color: #86868b;
  text-align: center;
}

