.warehouse-card {
  padding: 22rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.warehouse-label {
  color: #86868b;
  font-size: 23rpx;
  font-weight: 800;
}

.warehouse-name {
  margin-top: 6rpx;
  font-size: 32rpx;
  font-weight: 900;
}

.warehouse-action {
  color: #007aff;
  font-size: 26rpx;
  font-weight: 800;
}

.hero {
  min-height: 260rpx;
  padding: 34rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  background: linear-gradient(135deg, #ffffff 0%, #eaf4ff 100%);
}

.hero-label {
  color: #6e6e73;
  font-size: 26rpx;
  font-weight: 700;
}

.hero-title {
  margin-top: 18rpx;
  font-size: 58rpx;
  line-height: 70rpx;
  font-weight: 800;
}

.hero-sub {
  margin-top: 12rpx;
  color: #6e6e73;
  font-size: 27rpx;
}

.scan-button {
  width: 128rpx;
  height: 128rpx;
  border-radius: 64rpx;
  background: #007aff;
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 14rpx 28rpx rgba(0, 122, 255, 0.28);
}

.metric-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18rpx;
  margin-top: 22rpx;
}

.metric {
  padding: 26rpx;
}

.metric-value {
  font-size: 40rpx;
  font-weight: 800;
}

.metric-label {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #86868b;
}

.actions {
  display: grid;
  gap: 18rpx;
}

.action {
  padding: 24rpx;
  display: flex;
  align-items: center;
}

.action-icon {
  width: 74rpx;
  height: 74rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  display: block;
  filter: drop-shadow(0 10rpx 18rpx rgba(0, 0, 0, 0.08));
}

.action-icon-text {
  font-size: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  filter: none;
}

.admin-actions {
  display: flex;
  gap: 16rpx;
  margin-top: 36rpx;
  padding-bottom: 24rpx;
}

.admin-btn {
  flex: 1;
  padding: 26rpx;
  border-radius: 22rpx;
  font-size: 28rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.92);
  border: 1rpx solid rgba(0, 0, 0, 0.05);
  box-shadow: 0 12rpx 34rpx rgba(0, 0, 0, 0.06);
}

.backup-btn {
  color: #248a3d;
}

.restore-btn {
  color: #007AFF;
}

.action-title {
  font-size: 31rpx;
  font-weight: 700;
}

.action-sub,
.rental-sub {
  margin-top: 6rpx;
  color: #86868b;
  font-size: 24rpx;
}

.rental {
  padding: 24rpx;
  margin-bottom: 16rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rental-title {
  font-size: 30rpx;
  font-weight: 700;
}

.empty {
  padding: 36rpx;
  color: #86868b;
  text-align: center;
}
