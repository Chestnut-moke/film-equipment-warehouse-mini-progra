<wxs module="money" src="../../utils/money.wxs" />
<view class="page">
  <view class="state-error" wx:if="{{_error}}" bindtap="onRetry">加载失败，点击重试</view>
  <block wx:elif="{{!_loading}}">
  <view class="nav-title">影视设备管理系统</view>

  <view class="warehouse-card card" bindtap="goWarehouses">
    <view>
      <view class="warehouse-label">当前仓库</view>
      <view class="warehouse-name">{{currentWarehouseName}}</view>
    </view>
    <view class="warehouse-action">切换</view>
  </view>

  <view class="hero card">
    <view>
      <view class="hero-label">今日看板</view>
      <view class="hero-title">{{stats.availableCount}} 台可租</view>
      <view class="hero-sub">已借出 {{stats.rentedCount}} 台 · 逾期 {{stats.overdueCount}} 单</view>
    </view>
    <view class="scan-button" bindtap="scanDevice">扫码</view>
  </view>

  <view class="metric-grid">
    <view class="metric card">
      <view class="metric-value">{{stats.deviceCount}}</view>
      <view class="metric-label">设备总数</view>
    </view>
    <view class="metric card">
      <view class="metric-value">{{stats.monthRentalCount}}</view>
      <view class="metric-label">本月租赁</view>
    </view>
    <view class="metric card">
      <view class="metric-value">{{money.yuan(stats.monthIncome)}}</view>
      <view class="metric-label">本月收款</view>
    </view>
    <view class="metric card">
      <view class="metric-value">{{stats.repairingCount}}</view>
      <view class="metric-label">维修中</view>
    </view>
  </view>

  <view class="section-title">快捷操作</view>
  <view class="actions">
    <view class="action card" bindtap="goNewRental">
      <image class="action-icon" src="../../images/icons/action-new-rental.png" mode="aspectFit" />
      <view>
        <view class="action-title">新建租赁</view>
        <view class="action-sub">多台设备一起借出</view>
      </view>
    </view>
    <view class="action card" bindtap="goNewDevice">
      <image class="action-icon" src="../../images/icons/action-new-device.png" mode="aspectFit" />
      <view>
        <view class="action-title">新增设备</view>
        <view class="action-sub">编号、型号、租金</view>
      </view>
    </view>
    <view class="action card" bindtap="goDevices">
      <image class="action-icon" src="../../images/icons/action-library.png" mode="aspectFit" />
      <view>
        <view class="action-title">查看设备库</view>
        <view class="action-sub">筛状态和型号</view>
      </view>
    </view>
    <view class="action card" bindtap="goCustomers">
      <image class="action-icon" src="../../images/icons/action-customer.png" mode="aspectFit" />
      <view>
        <view class="action-title">租赁人</view>
        <view class="action-sub">电话、剧组、历史</view>
      </view>
    </view>
    <view class="action card" bindtap="goSchedule">
      <image class="action-icon" src="../../images/icons/action-schedule.png" mode="aspectFit" />
      <view>
        <view class="action-title">租借时间总览</view>
        <view class="action-sub">按日程查看占用</view>
      </view>
    </view>
  </view>

  <view class="section-title">进行中的租赁</view>
  <view class="empty card" wx:if="{{!dueRentals.length}}">暂无借出设备</view>
  <view class="rental card" wx:for="{{dueRentals}}" wx:key="_id" data-id="{{item._id}}" bindtap="openRental">
    <view>
      <view class="rental-title">{{item.customerSnapshot.name}}</view>
      <view class="rental-sub">{{item.devices.length}} 台设备 · 应还 {{item.expectedReturnAt}}</view>
    </view>
    <view class="status-pill status-{{item.displayStatus}}">{{item.statusText}}</view>
  </view>

  <view class="admin-actions">
    <view class="admin-btn backup-btn" bindtap="backupData">备份数据</view>
    <view class="admin-btn restore-btn" bindtap="restoreData">恢复数据</view>
  </view>
  </block>
</view>
