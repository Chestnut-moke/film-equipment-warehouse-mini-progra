.form {
  overflow: hidden;
}

.field {
  min-height: 104rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.field:last-child {
  border-bottom: none;
}

.label {
  color: #6e6e73;
  font-size: 24rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

input,
.picker-value {
  min-height: 48rpx;
  font-size: 30rpx;
  color: #1d1d1f;
}

textarea {
  width: 100%;
  min-height: 130rpx;
  font-size: 30rpx;
}

.save {
  margin-top: 28rpx;
}
