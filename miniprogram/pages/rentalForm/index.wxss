.segmented {
  padding: 8rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 8rpx;
}

.warehouse-hint {
  padding: 20rpx 24rpx;
  margin-bottom: 18rpx;
  color: #007aff;
  font-size: 27rpx;
  font-weight: 800;
}

.seg {
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  color: #6e6e73;
  font-size: 27rpx;
  font-weight: 800;
}

.seg.active {
  background: #1d1d1f;
  color: #fff;
}

.filters {
  white-space: nowrap;
  margin: 16rpx 0;
}

.filter {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 66rpx;
  padding: 0 28rpx;
  margin-right: 14rpx;
  border-radius: 999rpx;
  color: #6e6e73;
  background: #fff;
  font-size: 26rpx;
  font-weight: 700;
}

.filter.active {
  color: #fff;
  background: #1d1d1f;
}

.filter-empty {
  color: #c7c7cc;
}

.form {
  overflow: hidden;
}

.field {
  padding: 22rpx 24rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.06);
}

.field:last-child {
  border-bottom: none;
}

.label {
  color: #6e6e73;
  font-size: 23rpx;
  font-weight: 800;
  margin-bottom: 10rpx;
}

input,
textarea {
  width: 100%;
  font-size: 30rpx;
}

textarea {
  min-height: 120rpx;
}

.readonly {
  display: flex;
  justify-content: space-between;
  align-items: center;
  font-size: 32rpx;
  font-weight: 800;
}

.device {
  margin-bottom: 14rpx;
}

.device-label {
  padding: 22rpx;
  display: flex;
  align-items: center;
}

.device-text {
  margin-left: 18rpx;
  flex: 1;
}

.device-name {
  font-size: 30rpx;
  font-weight: 800;
}

.device-meta {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #86868b;
}

.summary {
  padding: 24rpx;
  margin-top: 24rpx;
}

.summary .row {
  margin-bottom: 14rpx;
  font-size: 28rpx;
}

.summary .row:last-child {
  margin-bottom: 0;
}

.submit {
  margin-top: 24rpx;
}

.empty {
  padding: 36rpx;
  color: #86868b;
  text-align: center;
}

.free-hint {
  font-size: 24rpx;
  font-weight: 400;
  color: #248a3d;
  margin-left: 8rpx;
}

.section-title-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.scan-entry {
  font-size: 26rpx;
  color: #6e6e73;
  padding: 6rpx 18rpx;
  border-radius: 999rpx;
  background: #fff;
  font-weight: 700;
}
