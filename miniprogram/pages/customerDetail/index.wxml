<wxs module="money" src="../../utils/money.wxs" />
<view class="page">
  <view class="state-error" wx:if="{{_error && !customer}}" bindtap="onRetry">加载失败，点击重试</view>
  <view class="state-hint card" wx:elif="{{!customer}}">加载客户信息...</view>
  <block wx:else>
    <!-- 客户信息卡片 -->
    <view class="info-card card">
      <view class="customer-name">{{customer.name}}</view>
      <view class="info-row" wx:if="{{customer.phone}}"><text class="label">电话</text><text>{{customer.phone}}</text></view>
      <view class="info-row" wx:if="{{customer.company}}"><text class="label">公司/剧组</text><text>{{customer.company}}</text></view>
      <view class="info-row" wx:if="{{customer.wechat}}"><text class="label">微信</text><text>{{customer.wechat}}</text></view>
      <view class="info-row" wx:if="{{customer.idCard}}"><text class="label">身份证</text><text>{{customer.idCard}}</text></view>
      <view class="info-row" wx:if="{{customer.address}}"><text class="label">地址</text><text>{{customer.address}}</text></view>
    </view>

    <!-- 统计 -->
    <view class="section-title">累计统计</view>
    <view class="metric-grid">
      <view class="metric card">
        <view class="metric-value">{{stats.totalCount}}</view>
        <view class="metric-label">总租赁次数</view>
      </view>
      <view class="metric card">
        <view class="metric-value">{{money.yuan(stats.totalAmount)}}</view>
        <view class="metric-label">累计金额</view>
      </view>
      <view class="metric card">
        <view class="metric-value">{{stats.activeCount}}</view>
        <view class="metric-label">进行中</view>
      </view>
      <view class="metric card">
        <view class="metric-value">{{stats.overdueCount}}</view>
        <view class="metric-label">逾期</view>
      </view>
    </view>

    <!-- 历史租赁单 -->
    <view class="section-title">历史租赁单</view>
    <view class="empty card" wx:if="{{!rentals.length}}">暂无租赁记录</view>
    <view class="rental card" wx:for="{{rentals}}" wx:key="_id" data-id="{{item._id}}" bindtap="openRental">
      <view class="row">
        <view class="rental-no">{{item.rentalNo}}</view>
        <view class="status-pill status-{{item.displayStatus}}">{{item.statusText}}</view>
      </view>
      <view class="rental-meta">{{item.devices.length}} 台设备 · {{item.startAt}} 至 {{item.expectedReturnAt}}</view>
      <view class="rental-meta money">
        租金 {{money.yuan(item.totalAmount)}} · 已收 {{money.yuan(item.paidAmount)}}
        <text wx:if="{{item.unpaidAmount > 0}}" class="unpaid"> · 未付 {{money.yuan(item.unpaidAmount)}}</text>
      </view>
    </view>
  </block>
</view>
