<view class="page">
  <view class="nav-title">租赁人</view>
  <view class="search card">
    <input placeholder="搜索姓名、电话、公司、微信" value="{{keyword}}" bindinput="onKeyword" />
  </view>

  <view class="empty card" wx:if="{{!customers.length}}">暂无租赁人；创建租赁单后会自动保存</view>
  <view class="customer card" wx:for="{{customers}}" wx:key="_id" data-id="{{item._id}}" data-name="{{item.name}}" bindtap="openDetail">
    <view class="row">
      <view class="name">{{item.name}}</view>
      <view class="count">租 {{item.rentalCount}} 次</view>
    </view>
    <view class="meta">{{item.phone}} · {{item.company || '无公司/剧组'}}</view>
    <view class="meta">微信 {{item.wechat || '-'}} · 当前未还 {{item.currentRentalCount}} 单</view>
    <view class="amount">累计金额 ¥{{item.totalAmount}}</view>
  </view>
</view>
