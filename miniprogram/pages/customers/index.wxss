.search {
  height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
}

.search input {
  width: 100%;
  font-size: 29rpx;
}

.customer {
  padding: 24rpx;
  margin-top: 16rpx;
}

.name {
  font-size: 34rpx;
  font-weight: 800;
}

.count {
  color: #007aff;
  font-size: 25rpx;
  font-weight: 800;
}

.meta,
.amount {
  margin-top: 8rpx;
  color: #86868b;
  font-size: 25rpx;
}

.amount {
  color: #1d1d1f;
  font-weight: 800;
}

.empty {
  padding: 36rpx;
  margin-top: 18rpx;
  text-align: center;
  color: #86868b;
}
